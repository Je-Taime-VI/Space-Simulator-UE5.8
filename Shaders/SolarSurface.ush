// Continuous body-fixed appearance shared by the globe and WorldScape materials.
// The permutation is supplied from the installed engine at asset-build time so
// that the gradient noise agrees with FMath::PerlinNoise3D in SolarModel.cpp.
struct FSolarSurfaceRegion
{
    float3 Color;
    float Sand, Rock, Soil, Snow, Temperature, Moisture, Vegetation, Water;
};
struct SolarField
{
    uint perm(int i)
    {
        static const uint p[256] = { @PERMUTATION@ };
        return p[i & 255];
    }
    float grad(uint h, float3 p)
    {
        static const float3 g[16] = {
            float3(1,0,1),float3(1,1,0),float3(0,1,1),float3(-1,1,0),
            float3(-1,0,1),float3(-1,-1,0),float3(0,-1,1),float3(1,-1,0),
            float3(1,0,-1),float3(0,1,-1),float3(-1,0,-1),float3(0,-1,-1),
            float3(1,1,0),float3(-1,1,0),float3(0,-1,1),float3(0,-1,-1)};
        return dot(g[h & 15],p);
    }
    float perlin(float3 p)
    {
        int3 c=(int3)floor(p); float3 f=frac(p),u=f*f*f*(f*(f*6-15)+10);
        int a=perm(c.x)+c.y,b=perm(c.x+1)+c.y;
        int aa=perm(a)+c.z,ab=perm(a+1)+c.z,ba=perm(b)+c.z,bb=perm(b+1)+c.z;
        return clamp(.97*lerp(
            lerp(lerp(grad(perm(aa),f),grad(perm(ba),f-float3(1,0,0)),u.x),
                 lerp(grad(perm(ab),f-float3(0,1,0)),grad(perm(bb),f-float3(1,1,0)),u.x),u.y),
            lerp(lerp(grad(perm(aa+1),f-float3(0,0,1)),grad(perm(ba+1),f-float3(1,0,1)),u.x),
                 lerp(grad(perm(ab+1),f-float3(0,1,1)),grad(perm(bb+1),f-1),u.x),u.y),u.z),-1,1);
    }
    float noise(float3 p,int count)
    {
        float v=0,a=.5;
        [loop] for(int i=0;i<count;i++){v+=a*perlin(p);p=p*2.03+float3(7.1,3.7,9.2);a*=.5;}
        return v;
    }
    float hash3(float3 p)
    {
        uint3 c=(uint3)(int3)p;
        uint h=c.x*73856093u^c.y*19349663u^c.z*83492791u;
        h=(h^(h>>13))*1274126177u;return (h&65535u)/65535.;
    }
    float detail(float3 p)
    {
        float3 c=floor(p),f=frac(p);f=f*f*(3-2*f);
        return lerp(lerp(lerp(hash3(c),hash3(c+float3(1,0,0)),f.x),lerp(hash3(c+float3(0,1,0)),hash3(c+float3(1,1,0)),f.x),f.y),
          lerp(lerp(hash3(c+float3(0,0,1)),hash3(c+float3(1,0,1)),f.x),lerp(hash3(c+float3(0,1,1)),hash3(c+1),f.x),f.y),f.z);
    }
    float axisZ(float3 n) { return n.z; }
    @BIOME_RULES@
    float land(float3 n)
    {
        float3 w=float3(noise(n*2+float3(12,4,0),3),noise(n*2+float3(2,17,3),3),noise(n*2+float3(8,7,19),3));
        return noise(n*2.6+w*1.7+float3(11.2,7.7,5.1),6)-.06;
    }
    float craters(float3 n)
    {
        float h=0;
        [loop] for(int layer=0;layer<3;layer++)
        {
            float scale=pow(3.,layer),best=100;float3 p=n*scale*19;int3 cell=(int3)floor(p);
            [loop] for(int x=-1;x<=1;x++) [loop] for(int y=-1;y<=1;y++) [loop] for(int z=-1;z<=1;z++)
            {
                int3 c=cell+int3(x,y,z);uint hash=(uint)c.x*73856093u^(uint)c.y*19349663u^(uint)c.z*83492791u;
                hash=hash*1664525u+1013904223u;float rx=(hash&65535u)/65535.;
                hash=hash*1664525u+1013904223u;float ry=(hash&65535u)/65535.;
                hash=hash*1664525u+1013904223u;float rz=(hash&65535u)/65535.;
                best=min(best,length(p-(float3(c)+float3(rx,ry,rz))));
            }
            h+=(-max(0.,1-pow(best/.39,2))+.23*exp(-pow((best-.43)/.065,2)))*1.8/scale;
        }
        return h;
    }
    float height(int body,float3 n)
    {
        if(body==3)
        {
            float c=land(n),hills=noise(n*170+float3(5,1,3),5),ridge=1-abs(noise(n*32,5)*2);
            float h=c*18+smoothstep(.03,.24,c)*pow(max(0.,ridge),5)*3.8;
            h+=(hills*.18+noise(n*9000+float3(19,2,8),4)*.11)*smoothstep(-.03,.08,c);
            if(abs(n.z)>.962)h=max(h,.08+(abs(n.z)-.962)*12+hills*.1);
            return clamp(h,-10,8.5);
        }
        if(body==1||body==4)return noise(n*7+float3(body,9,3),5)*2+craters(n);
        if(body==2)return noise(n*5+float3(5,3,14),6)*6;
        if(body==5)return noise(n*4+float3(13,2,5),6)*10+pow(max(0.,noise(n*15,5)*2),3)*12;
        return 0;
    }
    float cloud(float3 n)
    {
        float w=noise(n*8,4);
        return smoothstep(.02,.23,noise(n*15+float3(w*4,0,w),5));
    }
    // Pixel-only appearance variation; biome weights and CPU terrain stay unchanged.
    // Filter octaves smaller than a pixel instead of trading blur for shimmer.
    float appearanceNoise(float3 n)
    {
        float footprint=max(length(ddx(n)),length(ddy(n)))*140;
        float3 p=n*140+float3(4,1,3);
        float v=0,a=.5;
        for(int i=0;i<4;i++)
        {
            v+=a*perlin(p)*(1-smoothstep(.25,.75,footprint));
            p=p*2.03+float3(7.1,3.7,9.2);a*=.5;footprint*=2.03;
        }
        return v;
    }
    float3 surfaceAppearance(int body,float3 n,float h)
    {
        float3 c=biome(body,n,h,0).Color;
        if(body==3 && h<0)return c;
        float v=appearanceNoise(n);
        if(body==1||body==4)
        {
            // Reuse the height field; no second 81-cell crater search.
            float crater=h-noise(n*7+float3(body,9,3),5)*2;
            return c*clamp(1+v*.6+crater*.20,.4,1.3);
        }
        return c*clamp(1+v*(body==5?.5:.35),.65,1.35);
    }
    float3 color(int body,float3 n)
    {
        if(body>=1 && body<=5)return surfaceAppearance(body,n,height(body,n));
        float v=noise(n*140+float3(4,1,3),4);
        float latitude=asin(clamp(n.z,-1,1)),warp=noise(n*9,5),stripe=.5+.5*sin(latitude*85+warp*8);
        if(body==6)
        {
            float belt=.5+.5*sin(latitude*26+warp*1.4);
            float3 c=lerp(float3(.38,.20,.12),float3(.79,.68,.49),smoothstep(.12,.85,belt));
            float spot=exp(-pow((latitude+.36)/.10,2)-pow(atan2(n.y,n.x)/.24,2));
            return lerp(c,float3(.56,.18,.09),spot*.85)*(1+v*.17+.04*sin(latitude*140+warp*6));
        }
        if(body==7)return lerp(float3(.60,.49,.32),float3(.78,.68,.47),.5+.5*sin(latitude*32+warp*.8))*(1+v*.1+.025*sin(latitude*145+warp*3));
        if(body==8)return float3(.40,.64,.68)*(.96+.04*stripe);
        return float3(.34,.56,.67)*(.93+.07*stripe+v*.05);
    }
};
SolarField field;
